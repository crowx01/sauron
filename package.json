{
  "name": "sauron",
  "version": "2.0.0",
  "description": "Multi-provider AI orchestrator & offensive-security terminal framework",
  "type": "module",
  "bin": {
    "sauron": "bin/cli.js"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "test": "bun test tests/",
    "test:all": "bun test tests/ && bash -n setup.sh && bash bin/setup-lib.sh && bash bin/test-setup-lib.sh && bash bin/sauron-selftest",
    "typecheck": "bun x tsc --noEmit"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.4.3",
  "license": "MIT",
  "keywords": [
    "ai",
    "claude",
    "tui",
    "opencode",
    "pentest",
    "orchestrator",
    "multi-model"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/crowx01/sauron"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "docs/",
    "setup.sh",
    "settings.example.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "latest"
  }
}
