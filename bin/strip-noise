#!/usr/bin/env node
/**
 * strip-noise - deterministic terminal-noise pruner for command output.
 * High-performance Node/Bun replacement for legacy python script.
 *
 * Candidate #3 of the token-cutting roadmap. Removes non-semantic bloat from
 * stdout/stderr before it reaches Claude's context:
 *   * ANSI colour / cursor escape sequences
 *   * carriage-return progress bars & spinners (keeps only the final state of a line)
 *   * long stack traces / tracebacks - collapses the middle, keeping the top 2 and
 *     bottom 2 frames plus the exception line (the root cause and the throw site).
 */
import fs from 'fs';

const ANSI_REGEX = /\x1b\[[0-9;?]*[ -/]*[@-~]/g;
const OSC_REGEX = /\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)/g;

const FRAME_REGEX = /^\s*(at\s+\S|File\s+"|\s+File\s+"|from\s+\S+\s+import|\s+at\s|Traceback|\s+#\d+\s|goroutine\s|\s+\.\.\.\/|\s+\S+\.(?:go|rb|php|java|rs|ts|js|py):\d+)/;

function stripLineNoise(line) {
  let cleaned = line.replace(ANSI_REGEX, '').replace(OSC_REGEX, '');
  if (cleaned.includes('\r')) {
    const parts = cleaned.split('\r');
    cleaned = parts[parts.length - 1];
  }
  return cleaned;
}

function collapseTraces(lines, keep = 2) {
  const out = [];
  let run = [];

  function flush() {
    if (run.length > 2 * keep) {
      out.push(...run.slice(0, keep));
      out.push(`    ... ${run.length - 2 * keep} frames elided by strip-noise ...`);
      out.push(...run.slice(-keep));
    } else {
      out.push(...run);
    }
    run = [];
  }

  for (const ln of lines) {
    if (FRAME_REGEX.test(ln)) {
      run.push(ln);
    } else {
      if (run.length > 0) flush();
      out.push(ln);
    }
  }
  if (run.length > 0) flush();
  return out;
}

async function main() {
  const args = process.argv.slice(2);
  let raw = '';

  if (args.length > 0) {
    for (const f of args) {
      if (fs.existsSync(f)) {
        raw += fs.readFileSync(f, 'utf-8');
      }
    }
  } else {
    raw = fs.readFileSync(0, 'utf-8');
  }

  let data = raw.split('\n');
  if (data.length > 0 && data[data.length - 1] === '') {
    data.pop();
  }

  data = data.map(stripLineNoise);
  data = collapseTraces(data);
  process.stdout.write(data.join('\n') + (data.length ? '\n' : ''));
}

main().catch((err) => {
  console.error(err);
  process.exit(1);
});
