#!/usr/bin/env node
/**
 * sauron-normalize - deterministic dense-TSV normalizer for recon JSON-L.
 * High-performance Node/Bun replacement for legacy python script.
 *
 * Candidate #1 of the token-cutting roadmap. Converts the verbose JSON-L emitted by
 * httpx / subfinder / dnsx / naabu / nuclei into an ultra-dense TSV with a single
 * header row, stripping the repeated JSON key names that dominate raw payloads.
 * Runs BEFORE anything reaches Claude's context or a PAL model, so the saving is
 * free (0 tokens, 0 latency, deterministic - it cannot refuse or hallucinate).
 */
import fs from 'fs';
import readline from 'readline';

const SCHEMAS = [
  // nuclei: findings are the highest-value signal
  { name: 'nuclei', required: ['template-id'], cols: ['severity', 'template-id', 'matched-at', 'host', 'info.name'] },
  // httpx: live-host fingerprint
  { name: 'httpx', required: ['url', 'status_code'], cols: ['url', 'status_code', 'title', 'webserver', 'tech', 'content_length', 'host'] },
  // dnsx: resolution
  { name: 'dnsx', required: ['host', 'a'], cols: ['host', 'a', 'aaaa', 'cname'] },
  // naabu: open ports
  { name: 'naabu', required: ['port'], cols: ['host', 'ip', 'port'] },
  // subfinder / generic host list
  { name: 'subfinder', required: ['host'], cols: ['host', 'source'] },
];

function dig(obj, dotted) {
  let cur = obj;
  for (const part of dotted.split('.')) {
    if (cur && typeof cur === 'object' && part in cur) {
      cur = cur[part];
    } else {
      return '';
    }
  }
  if (Array.isArray(cur)) return cur.join(',');
  return cur == null ? '' : String(cur);
}

function pickSchema(obj) {
  for (const schema of SCHEMAS) {
    if (schema.required.every((k) => dig(obj, k) !== '')) {
      return schema;
    }
  }
  return null;
}

function cell(v) {
  return v.replace(/\t/g, ' ').replace(/\r/g, ' ').replace(/\n/g, ' ');
}

async function processStream(stream) {
  const printedHeader = new Set();
  const rl = readline.createInterface({ input: stream, crlfDelay: Infinity });

  for await (const rawLine of rl) {
    const line = rawLine.trim();
    if (!line) continue;

    let obj;
    try {
      obj = JSON.parse(line);
    } catch {
      process.stdout.write(rawLine + '\n');
      continue;
    }

    if (!obj || typeof obj !== 'object' || Array.isArray(obj)) {
      process.stdout.write(rawLine + '\n');
      continue;
    }

    const schema = pickSchema(obj);
    if (!schema) {
      process.stdout.write(rawLine + '\n');
      continue;
    }

    if (!printedHeader.has(schema.name)) {
      process.stdout.write(`# ${schema.name}\t${schema.cols.join('\t')}\n`);
      printedHeader.add(schema.name);
    }

    const row = schema.cols.map((c) => cell(dig(obj, c))).join('\t');
    process.stdout.write(row + '\n');
  }
}

async function main() {
  const args = process.argv.slice(2).filter((a) => a !== '-');
  if (args.length === 0) {
    await processStream(process.stdin);
  } else {
    for (const file of args) {
      if (fs.existsSync(file)) {
        await processStream(fs.createReadStream(file, { encoding: 'utf-8' }));
      }
    }
  }
}

main().catch((err) => {
  console.error(err);
  process.exit(1);
});
