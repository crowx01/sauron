# ── sauron engine configuration (reference) ──────────────────────────────────
# The interactive installer (`setup.sh`) writes a tailored `.env.sauron` next to
# your orchestrator config based on the models you pick — that generated file is
# the one you `source` before starting your orchestrator. This root template is
# the consolidated reference for EVERY variable the bundled core engine reads.
#
#   source ./.env.sauron        # the installer-generated file (real keys, 0600)
#
# Provider API keys — set the ones for the model tiers you enabled:
export GEMINI_API_KEY=your-gemini-key              # Gemini flash / pro
export OPENROUTER_API_KEY=your-openrouter-key      # nemotron / grok / openrouter-free
export CUSTOM_API_URL=https://api.groq.com/openai/v1   # Groq (gpt-oss + qwen3 default executor)
export CUSTOM_API_KEY=your-groq-key
export OPENAI_API_KEY=your-openai-key              # optional, gpt-5 tiers

# ── engine (internal "PAL") feature toggles — sensible defaults in-code ───────
# Override only to change behavior; the installer sets DEFAULT_MODEL + PAL_TOOLBELT
# in the MCP registration (mcpServers.pal.env) for the Claude Code path.
# DEFAULT_MODEL=auto            # capability-aware auto routing
# PAL_TOOLBELT=1                # agentic tool-loop (bash/read_file/gh/web_fetch); config ~/.pal/toolbelt.json
# PAL_TOOLS_CTX_CHARS=16000     # tool-loop context trim (raise for large-context models)
# PAL_CAVEMAN=ultra             # output compression
# PAL_HEADROOM=1                # compress large tool/scan output before it enters context
# PAL_AUTHZ_DISABLE=0           # executor authorization boundary (scope + secret guard) — leave ON
